<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentAssistantWorkbench.Views.ContextCachePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        Padding="24,20"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" Spacing="16">
            <StackPanel Spacing="5">
                <TextBlock
                    Text="Reference Context"
                    FontSize="26"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Save reference text for the active connection. The app includes it with future prompts; Apply does not contact the model."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Saved reference estimate"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AppliedCacheEstimateText"
                            Text="0 tokens"
                            FontSize="20"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Draft estimate"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="DraftCacheEstimateText"
                            Text="0 tokens"
                            FontSize="20"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Remaining after draft"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="RemainingContextEstimateText"
                            Text="32,768 tokens"
                            FontSize="20"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="3"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Context window"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="ContextWindowText"
                            Text="32,768 tokens"
                            FontSize="20"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Padding="18"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="Reference text"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="CacheTargetText"
                                Text="Private · Windows Ollama"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Content="Upload text"
                                Click="OpenTextFile_Click" />
                            <Button
                                x:Name="ClearCacheButton"
                                Content="Clear context"
                                Click="ClearContext_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="CacheTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="320"
                        MaxHeight="560"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        PlaceholderText="Paste your reference notes or other text here..."
                        TextChanged="CacheTextBox_TextChanged"
                        FontFamily="Cascadia Code, Consolas"
                        FontSize="13" />

                    <Grid Grid.Row="2">
                        <TextBlock
                            x:Name="CacheCharacterCountText"
                            Text="0 characters · approximate token count"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="Estimated at roughly 1 token per 4 characters"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Right" />
                    </Grid>

                    <InfoBar
                        x:Name="CacheInfoBar"
                        Grid.Row="3"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <TextBlock
                    Text="This is saved locally, not stored as a persistent model KV session. Each chat request includes the reference text again; Apply itself sends no model request. Public connections send it to the configured provider."
                    MaxWidth="680"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ApplyContextButton"
                        Content="Apply context"
                        Click="ApplyContext_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
