<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentAssistantWorkbench.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Storyboard x:Name="AmbientMistStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="Orb1Transform"
                Storyboard.TargetProperty="TranslateX"
                From="-40"
                To="70"
                Duration="0:0:12" />
            <DoubleAnimation
                Storyboard.TargetName="Orb1Transform"
                Storyboard.TargetProperty="TranslateY"
                From="-20"
                To="35"
                Duration="0:0:15" />
            <DoubleAnimation
                Storyboard.TargetName="Orb2Transform"
                Storyboard.TargetProperty="TranslateX"
                From="50"
                To="-65"
                Duration="0:0:14" />
            <DoubleAnimation
                Storyboard.TargetName="Orb2Transform"
                Storyboard.TargetProperty="TranslateY"
                From="25"
                To="-30"
                Duration="0:0:11" />
        </Storyboard>
    </Page.Resources>

    <!-- Plain Light Translucent Animated Backdrop -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                    <GradientStop Color="#14FFFFFF" Offset="0.0" />
                    <GradientStop Color="#0AE0F2FE" Offset="0.6" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                Width="520"
                Height="380"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="-120,-110,0,0"
                Opacity="0.65">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="Orb1Transform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2238BDF8" Offset="0.0" />
                        <GradientStop Color="#0038BDF8" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                Width="460"
                Height="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-100,-90"
                Opacity="0.6">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="Orb2Transform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1C7DD3FC" Offset="0.0" />
                        <GradientStop Color="#007DD3FC" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Continual Conversational Bubble Ladder -->
        <ScrollViewer
            x:Name="LadderScrollViewer"
            Grid.Row="0"
            Padding="24,18"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Spacing="16">

                <!-- Empty State Welcome Bubble -->
                <Border
                    x:Name="EmptyCloudCard"
                    Padding="32"
                    CornerRadius="28"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    MaxWidth="600"
                    Margin="0,32,0,0">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="Personal Assistant"
                            Style="{StaticResource TitleTextBlockStyle}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptySubtitleText"
                            Text="Type or speak using your Windows microphone. Questions and answers appear together in one clean bubble."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Unified Q&A Conversation Bubbles -->
                <ItemsControl x:Name="ConversationItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,14"
                                MaxWidth="780"
                                HorizontalAlignment="Stretch"
                                Padding="16"
                                CornerRadius="26,26,26,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <!-- Question Block (Theme Question Color Code + Accent Bar) -->
                                    <Border
                                        Padding="14,11"
                                        CornerRadius="18"
                                        Background="{Binding QuestionBackgroundBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                CornerRadius="2"
                                                Background="{Binding QuestionAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    Text="{Binding QuestionHeaderLabel}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    Foreground="{Binding QuestionAccentBrush}" />
                                                <TextBlock
                                                    Text="{Binding QuestionContent}"
                                                    FontSize="15"
                                                    FontWeight="Medium"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- In-Bubble Working / Hourglass Indicator -->
                                    <StackPanel
                                        Visibility="{Binding WaitingVisibility}"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Padding="12,4">
                                        <ProgressRing
                                            IsActive="True"
                                            Width="16"
                                            Height="16" />
                                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="Thinking..."
                                            FontSize="13"
                                            FontFamily="{Binding BubbleFontFamily}"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Answer Block inside Same Bubble (Theme Answer Color Code + Accent Bar) -->
                                    <Border
                                        Visibility="{Binding ReplyVisibility}"
                                        Padding="14,12"
                                        CornerRadius="18"
                                        Background="{Binding AnswerBackgroundBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                CornerRadius="2"
                                                Background="{Binding AnswerAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBlock
                                                    Text="{Binding ReplyHeaderLabel}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    Foreground="{Binding AnswerAccentBrush}" />
                                                <TextBlock
                                                    Text="{Binding ReplyContent}"
                                                    FontSize="14"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <Button
                                                        Click="SpeakTurnButton_Click"
                                                        Tag="{Binding ReplyContent}"
                                                        CornerRadius="14"
                                                        Padding="12,5">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE767;" FontSize="13" />
                                                            <TextBlock Text="Play in Windows Speaker" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Error Notice inside the Same Bubble -->
                                    <Border
                                        Visibility="{Binding ErrorVisibility}"
                                        Padding="14,11"
                                        CornerRadius="18"
                                        Background="#1ADC2626">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="{Binding ReplyHeaderLabel}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                FontFamily="{Binding BubbleFontFamily}"
                                                Foreground="#DC2626" />
                                            <TextBlock
                                                Text="{Binding ReplyContent}"
                                                FontFamily="{Binding BubbleFontFamily}"
                                                TextWrapping="Wrap"
                                                Foreground="#DC2626" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Microphone / Export Status Banner -->
        <InfoBar
            x:Name="MicErrorInfoBar"
            Grid.Row="1"
            Margin="24,0,24,4"
            MaxWidth="840"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    x:Name="MicFixActionButton"
                    Content="Open Speech Settings"
                    Click="MicFixActionButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Tall Floating Bubble Composer Dock (3x Prompt Space + Save PDF) -->
        <Border
            Grid.Row="2"
            Margin="24,8,24,18"
            Padding="12"
            MaxWidth="840"
            CornerRadius="24"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="MicButton"
                    Grid.Column="0"
                    Click="MicButton_Click"
                    ToolTipService.ToolTip="Speak via Windows Microphone (click again to stop)"
                    VerticalAlignment="Bottom"
                    Height="42"
                    Width="44"
                    CornerRadius="14">
                    <FontIcon x:Name="MicButtonIcon" Glyph="&#xE720;" FontSize="16" />
                </Button>

                <TextBox
                    x:Name="PromptTextBox"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="118"
                    MaxHeight="220"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="PromptTextBox_PreviewKeyDown"
                    PlaceholderText="Type or speak your prompt... (Enter to send, Shift+Enter for new line)"
                    CornerRadius="16"
                    Padding="14,10"
                    VerticalAlignment="Stretch" />

                <Button
                    x:Name="SavePdfButton"
                    Grid.Column="2"
                    Click="SavePdfButton_Click"
                    ToolTipService.ToolTip="Save Conversation as PDF"
                    AutomationProperties.Name="Save Conversation as PDF"
                    VerticalAlignment="Bottom"
                    Height="42"
                    Width="42"
                    Padding="0"
                    CornerRadius="14">
                    <FontIcon Glyph="&#xEA90;" FontSize="15" />
                </Button>

                <Button
                    x:Name="NewSessionButton"
                    Grid.Column="3"
                    Click="NewSession_Click"
                    ToolTipService.ToolTip="New Session"
                    AutomationProperties.Name="New Session"
                    VerticalAlignment="Bottom"
                    Height="42"
                    Width="42"
                    Padding="0"
                    CornerRadius="14">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>

                <Button
                    x:Name="SendButton"
                    Grid.Column="4"
                    Click="SendButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Height="42"
                    Padding="18,0"
                    CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing
                            x:Name="SendSpinner"
                            Visibility="Collapsed"
                            IsActive="False"
                            Width="14"
                            Height="14"
                            Foreground="White" />
                        <TextBlock x:Name="SendLabel" Text="Send" />
                        <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
