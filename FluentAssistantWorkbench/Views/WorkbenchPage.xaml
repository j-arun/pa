<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentAssistantWorkbench.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentAssistantWorkbench.Controls">

    <Page.Resources>
        <Storyboard x:Name="AmbientMistStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="Orb1Transform"
                Storyboard.TargetProperty="TranslateX"
                From="-40"
                To="70"
                Duration="0:0:12" />
            <DoubleAnimation
                Storyboard.TargetName="Orb1Transform"
                Storyboard.TargetProperty="TranslateY"
                From="-20"
                To="35"
                Duration="0:0:15" />
            <DoubleAnimation
                Storyboard.TargetName="Orb2Transform"
                Storyboard.TargetProperty="TranslateX"
                From="50"
                To="-65"
                Duration="0:0:14" />
            <DoubleAnimation
                Storyboard.TargetName="Orb2Transform"
                Storyboard.TargetProperty="TranslateY"
                From="25"
                To="-30"
                Duration="0:0:11" />
        </Storyboard>
    </Page.Resources>

    <!-- Plain Light Translucent Animated Backdrop -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                    <GradientStop Color="#14FFFFFF" Offset="0.0" />
                    <GradientStop Color="#0AE0F2FE" Offset="0.6" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                Width="520"
                Height="380"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="-120,-110,0,0"
                Opacity="0.65">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="Orb1Transform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2238BDF8" Offset="0.0" />
                        <GradientStop Color="#0038BDF8" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                Width="460"
                Height="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-100,-90"
                Opacity="0.6">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="Orb2Transform" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1C7DD3FC" Offset="0.0" />
                        <GradientStop Color="#007DD3FC" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

        </Grid>

        <!-- Continual Conversational Bubble Ladder -->
        <ScrollViewer
            x:Name="LadderScrollViewer"
            Grid.Row="0"
            Padding="24,18"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Enabled">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Spacing="16">

                <!-- Empty State Welcome Bubble -->
                <Border
                    x:Name="EmptyCloudCard"
                    Padding="32"
                    CornerRadius="28"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    MaxWidth="600"
                    Margin="0,32,0,0">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="Personal Assistant"
                            Style="{StaticResource TitleTextBlockStyle}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptySubtitleText"
                            Text="Private mode · Type a prompt for your local Ollama model."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Unified Q&A Conversation Bubbles -->
                <ItemsControl x:Name="ConversationItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,14"
                                MaxWidth="780"
                                HorizontalAlignment="Stretch"
                                Padding="16"
                                CornerRadius="26,26,26,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Border
                                            HorizontalAlignment="Left"
                                            Padding="11,5"
                                            CornerRadius="9"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock
                                                    Text="Thread #"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding ThreadNumber, Mode=OneWay}"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Click="CopyMetadata_Click"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Copy the prompt, system instruction, and context cache"
                                                AutomationProperties.Name="Copy thread metadata">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                    <TextBlock Text="Copy Metadata" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="ShowSourcePrompt_Click"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Show the exact composed prompt sent for this thread"
                                                AutomationProperties.Name="Show source prompt">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                                    <TextBlock Text="Source Prompt" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="DownloadExchangeHtml_Click"
                                                IsEnabled="{Binding HasSuccessfulAnswer}"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Download only this thread's question and answers as HTML"
                                                AutomationProperties.Name="Download this thread as HTML">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                    <TextBlock Text="Download" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="CopyExchange_Click"
                                                IsEnabled="{Binding HasSuccessfulAnswer}"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Copy this thread's question and answers"
                                                AutomationProperties.Name="Copy thread question and answers">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                    <TextBlock Text="Copy" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="DeleteExchange_Click"
                                                IsEnabled="{Binding CanDelete}"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Delete only this thread from the session"
                                                AutomationProperties.Name="Delete this thread">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                    <TextBlock Text="Delete" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="ToggleThread_Click"
                                                Padding="8,5"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="{Binding ThreadToggleToolTip}"
                                                AutomationProperties.Name="{Binding ThreadToggleToolTip}">
                                                <FontIcon
                                                    Glyph="{Binding ThreadToggleGlyph}"
                                                    FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Visibility="{Binding ThreadContentVisibility}" Spacing="10">
                                    <!-- Question Block (Theme Question Color Code + Accent Bar) -->
                                    <Border
                                        Padding="14,11"
                                        CornerRadius="18"
                                        Background="{Binding QuestionBackgroundBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                CornerRadius="2"
                                                Background="{Binding QuestionAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding QuestionAccentBrush}">
                                                        <FontIcon
                                                            Glyph="&#xE77B;"
                                                            FontSize="14"
                                                            Foreground="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding QuestionHeaderLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        FontFamily="{Binding BubbleFontFamily}"
                                                        Foreground="{Binding QuestionAccentBrush}"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="ToggleQuestion_Click"
                                                        Padding="6"
                                                        MinWidth="32"
                                                        MinHeight="32"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="{Binding QuestionToggleToolTip}"
                                                        AutomationProperties.Name="{Binding QuestionToggleToolTip}">
                                                        <FontIcon
                                                            Glyph="{Binding QuestionToggleGlyph}"
                                                            FontSize="14" />
                                                    </Button>
                                                </Grid>
                                                <controls:MarkdownPresenter
                                                    Visibility="{Binding QuestionContentVisibility}"
                                                    Markdown="{Binding QuestionContent}"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    FontWeight="Medium"
                                                    FontSize="{Binding QuestionFontSize}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- In-Bubble Working / Hourglass Indicator -->
                                    <StackPanel
                                        Visibility="{Binding WaitingVisibility}"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Padding="12,4">
                                        <ProgressRing
                                            IsActive="True"
                                            Width="16"
                                            Height="16" />
                                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="Thinking..."
                                            FontSize="13"
                                            FontFamily="{Binding BubbleFontFamily}"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Grid
                                        Visibility="{Binding DualResponseVisibility}"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Padding="12"
                                            CornerRadius="18"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            DataContext="{Binding PrivateResponse}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        Text="{Binding HeaderLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock
                                                        Text="{Binding MetricsText}"
                                                        FontSize="10"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Visibility="{Binding WaitingVisibility}"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <ProgressRing IsActive="True" Width="16" Height="16" />
                                                    <TextBlock
                                                        Text="Waiting for Ollama..."
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <controls:MarkdownPresenter
                                                    Visibility="{Binding ContentVisibility}"
                                                    Markdown="{Binding Content}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock
                                                    Visibility="{Binding ErrorVisibility}"
                                                    Text="{Binding ErrorText}"
                                                    TextWrapping="Wrap"
                                                    FontSize="12"
                                                    Foreground="#DC2626" />
                                                <Button
                                                    Visibility="{Binding ContentVisibility}"
                                                    Click="SpeakTurnButton_Click"
                                                    HorizontalAlignment="Left"
                                                    Padding="8"
                                                    CornerRadius="10"
                                                    ToolTipService.ToolTip="{Binding SpeakerToolTip}"
                                                    AutomationProperties.Name="{Binding SpeakerToolTip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding SpeakerGlyph}" FontSize="16" />
                                                        <TextBlock
                                                            Text="{Binding SpeakerButtonText}"
                                                            FontSize="12"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Padding="12"
                                            CornerRadius="18"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            DataContext="{Binding PublicResponse}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        Text="{Binding HeaderLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock
                                                        Text="{Binding MetricsText}"
                                                        FontSize="10"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Visibility="{Binding WaitingVisibility}"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <ProgressRing IsActive="True" Width="16" Height="16" />
                                                    <TextBlock
                                                        Text="Waiting for public LLM..."
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <controls:MarkdownPresenter
                                                    Visibility="{Binding ContentVisibility}"
                                                    Markdown="{Binding Content}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock
                                                    Visibility="{Binding ErrorVisibility}"
                                                    Text="{Binding ErrorText}"
                                                    TextWrapping="Wrap"
                                                    FontSize="12"
                                                    Foreground="#DC2626" />
                                                <Button
                                                    Visibility="{Binding ContentVisibility}"
                                                    Click="SpeakTurnButton_Click"
                                                    HorizontalAlignment="Left"
                                                    Padding="8"
                                                    CornerRadius="10"
                                                    ToolTipService.ToolTip="{Binding SpeakerToolTip}"
                                                    AutomationProperties.Name="{Binding SpeakerToolTip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding SpeakerGlyph}" FontSize="16" />
                                                        <TextBlock
                                                            Text="{Binding SpeakerButtonText}"
                                                            FontSize="12"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Answer Block inside Same Bubble (Theme Answer Color Code + Accent Bar) -->
                                    <Border
                                        Visibility="{Binding ReplyVisibility}"
                                        Padding="14,12"
                                        CornerRadius="18"
                                        Background="{Binding AnswerBackgroundBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                CornerRadius="2"
                                                Background="{Binding AnswerAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding AnswerAccentBrush}">
                                                        <FontIcon
                                                            Glyph="&#xE8F2;"
                                                            FontSize="14"
                                                            Foreground="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="AI"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            FontFamily="{Binding BubbleFontFamily}"
                                                            Foreground="{Binding AnswerAccentBrush}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Text="{Binding ReplyHeaderLabel}"
                                                            FontSize="11"
                                                            FontFamily="{Binding BubbleFontFamily}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Text="{Binding ReplyMetricsText}"
                                                            FontSize="10"
                                                            FontFamily="{Binding BubbleFontFamily}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxWidth="420"
                                                            ToolTipService.ToolTip="{Binding ReplyMetricsText}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="ToggleReply_Click"
                                                        Padding="6"
                                                        MinWidth="32"
                                                        MinHeight="32"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="{Binding ReplyToggleToolTip}"
                                                        AutomationProperties.Name="{Binding ReplyToggleToolTip}">
                                                        <FontIcon
                                                            Glyph="{Binding ReplyToggleGlyph}"
                                                            FontSize="14" />
                                                    </Button>
                                                </Grid>
                                                <controls:MarkdownPresenter
                                                    Visibility="{Binding ReplyContentVisibility}"
                                                    Markdown="{Binding ReplyContent}"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    FontSize="{Binding ReplyFontSize}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding ReplyContentVisibility}">
                                                    <Button
                                                        Click="SpeakTurnButton_Click"
                                                        Padding="8"
                                                        CornerRadius="10"
                                                        ToolTipService.ToolTip="{Binding ReplySpeakerToolTip}"
                                                        AutomationProperties.Name="{Binding ReplySpeakerToolTip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon
                                                                Glyph="{Binding ReplySpeakerGlyph}"
                                                                FontSize="16" />
                                                            <TextBlock
                                                                Text="{Binding ReplySpeakerButtonText}"
                                                                FontSize="12"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Error Notice inside the Same Bubble -->
                                    <Border
                                        Visibility="{Binding ErrorVisibility}"
                                        Padding="14,11"
                                        CornerRadius="18"
                                        Background="#1ADC2626">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="{Binding ReplyHeaderLabel}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                FontFamily="{Binding BubbleFontFamily}"
                                                Foreground="#DC2626" />
                                            <TextBlock
                                                Text="{Binding ReplyContent}"
                                                FontFamily="{Binding BubbleFontFamily}"
                                                TextWrapping="Wrap"
                                                Foreground="#DC2626" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Visibility="{Binding CanceledVisibility}"
                                        Padding="14,11"
                                        CornerRadius="18"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{Binding ReplyHeaderLabel}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{Binding ReplyMetricsText}"
                                                    FontSize="10"
                                                    FontFamily="{Binding BubbleFontFamily}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding ReplyContent}"
                                                FontFamily="{Binding BubbleFontFamily}"
                                                TextWrapping="Wrap"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Export Status Banner -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="24,0,24,4"
            MaxWidth="840"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

    </Grid>
</Page>
