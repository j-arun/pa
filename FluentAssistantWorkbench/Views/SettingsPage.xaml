<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentAssistantWorkbench.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Spacing="16">
            <!-- Section 0: Appearance & Windows Account Profile -->
            <Border
                Padding="16"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Themes &amp; Windows Account Profile" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ThemeCombo"
                            Grid.Row="0"
                            Grid.Column="0"
                            Header="Color Theme"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Windows System Default" Tag="System" />
                            <ComboBoxItem Content="Arctic Sky (#0284C7 · Light)" Tag="ArcticSky" />
                            <ComboBoxItem Content="Midnight Slate (#38BDF8 · Dark)" Tag="MidnightSlate" />
                            <ComboBoxItem Content="Emerald Mist (#059669 · Light)" Tag="EmeraldMist" />
                            <ComboBoxItem Content="Royal Amethyst (#A855F7 · Dark)" Tag="RoyalAmethyst" />
                        </ComboBox>
                        <ComboBox
                            x:Name="FontCombo"
                            Grid.Row="0"
                            Grid.Column="1"
                            Header="Font Style"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Segoe UI (Default)" Tag="SegoeUI" />
                            <ComboBoxItem Content="Calibri (Clean Sans)" Tag="Calibri" />
                            <ComboBoxItem Content="Georgia (Editorial Serif)" Tag="Georgia" />
                            <ComboBoxItem Content="Cascadia Mono (Technical)" Tag="CascadiaMono" />
                        </ComboBox>
                        <TextBox
                            x:Name="DisplayNameBox"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Header="Account Display Name"
                            PlaceholderText="Windows logged-in user" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Sync Windows Account Picture" Click="DetectWindowsProfile_Click" />
                        <TextBlock
                            Text="Uses your signed-in Windows account profile picture automatically."
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 1: Private LLM (Windows Ollama) -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Private LLM (Windows Ollama)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            Content="Discover Local Models"
                            Click="DiscoverOllama_Click"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="OllamaUrlBox"
                            Grid.Column="0"
                            Header="Ollama Daemon URL"
                            PlaceholderText="http://127.0.0.1:11434" />
                        <TextBox
                            x:Name="OllamaModelBox"
                            Grid.Column="1"
                            Header="Selected Private Model"
                            PlaceholderText="e.g. llama3.2" />
                    </Grid>

                    <TextBlock
                        x:Name="OllamaStatusText"
                        Text="Click Discover Local Models to list models deployed in Windows Ollama."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <ListView
                        x:Name="OllamaModelsList"
                        MaxHeight="180"
                        SelectionChanged="OllamaModelsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SummaryLine}" Padding="4,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OllamaContextCombo" Grid.Column="0" Header="Context Window (num_ctx)" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="4,096 tokens (Low RAM)" Tag="4096" />
                            <ComboBoxItem Content="8,192 tokens (Balanced)" Tag="8192" />
                            <ComboBoxItem Content="16,384 tokens (Long)" Tag="16384" />
                            <ComboBoxItem Content="32,768 tokens (Max)" Tag="32768" />
                        </ComboBox>
                        <ComboBox x:Name="OllamaKeepAliveCombo" Grid.Column="1" Header="Memory Keep-Alive" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Unload immediately (0)" Tag="0" />
                            <ComboBoxItem Content="2 minutes" Tag="2m" />
                            <ComboBoxItem Content="5 minutes" Tag="5m" />
                            <ComboBoxItem Content="10 minutes (Default)" Tag="10m" />
                            <ComboBoxItem Content="30 minutes" Tag="30m" />
                        </ComboBox>
                        <ComboBox x:Name="OllamaHistoryCombo" Grid.Column="2" Header="History Window" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Last 4 turns (Lightest)" Tag="4" />
                            <ComboBoxItem Content="Last 8 turns (Fast)" Tag="8" />
                            <ComboBoxItem Content="Last 12 turns" Tag="12" />
                            <ComboBoxItem Content="Last 16 turns (Default)" Tag="16" />
                            <ComboBoxItem Content="Last 24 turns" Tag="24" />
                        </ComboBox>
                    </Grid>

                    <TextBox
                        x:Name="PrivateSystemBox"
                        Header="Private System Instruction"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="64" />
                </StackPanel>
            </Border>

            <!-- Section 2: Public LLM Adapters -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Public LLM Adapters" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ComboBox
                        x:Name="ActivePublicAdapterCombo"
                        Header="Active Public Adapter"
                        Width="260">
                        <ComboBoxItem Content="Gemini Pro" Tag="gemini" />
                        <ComboBoxItem Content="Claude (Anthropic)" Tag="claude" />
                        <ComboBoxItem Content="Fable" Tag="fable" />
                    </ComboBox>

                    <!-- Gemini Pro Adapter -->
                    <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Gemini Pro Adapter" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Content="Test Gemini" Tag="gemini" Click="TestAdapter_Click" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GeminiModelBox" Grid.Column="0" Header="Model" />
                                <PasswordBox x:Name="GeminiKeyBox" Grid.Column="1" Header="API Key (or GEMINI_API_KEY env)" />
                            </Grid>
                            <TextBox x:Name="GeminiSystemBox" Header="System Instruction" />
                        </StackPanel>
                    </Border>

                    <!-- Claude Adapter -->
                    <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Claude Adapter" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Content="Test Claude" Tag="claude" Click="TestAdapter_Click" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClaudeModelBox" Grid.Column="0" Header="Model" />
                                <PasswordBox x:Name="ClaudeKeyBox" Grid.Column="1" Header="API Key (or ANTHROPIC_API_KEY env)" />
                            </Grid>
                            <TextBox x:Name="ClaudeEndpointBox" Header="Endpoint URL" />
                        </StackPanel>
                    </Border>

                    <!-- Fable Adapter -->
                    <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Fable Adapter" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Content="Test Fable" Tag="fable" Click="TestAdapter_Click" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FableModelBox" Grid.Column="0" Header="Model" />
                                <PasswordBox x:Name="FableKeyBox" Grid.Column="1" Header="API Key (or FABLE_API_KEY env)" />
                            </Grid>
                            <TextBox x:Name="FableEndpointBox" Header="Endpoint URL" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="AdapterHealthText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Section 3: Windows Native Voice & Local Storage -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Windows Native Voice &amp; Local Laptop Storage" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            x:Name="VoicesCombo"
                            Header="Windows Installed Speaker Voice"
                            Width="340"
                            DisplayMemberPath="DisplayName" />
                        <Button
                            Content="Test Windows Speaker"
                            Click="TestSpeaker_Click"
                            VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox x:Name="AutoSpeakPublicCheck" Content="Auto-play Public LLM replies" />
                        <CheckBox x:Name="AutoSpeakPrivateCheck" Content="Auto-play Private Ollama replies" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox x:Name="SoundOnReplyCheck" Content="Play chime sound when LLM responds" />
                        <CheckBox x:Name="DesktopNotifyOnReplyCheck" Content="Show Windows notification on reply" />
                        <Button
                            Content="Test Chime &amp; Notify"
                            Click="TestReplyNotification_Click"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StoragePathText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear App Cache" Click="ClearCache_Click" />
                        <Button Content="Unload Ollama Memory" Click="UnloadOllamaMemory_Click" />
                        <Button
                            Content="Reset Cache &amp; LLM"
                            Click="ResetCacheAndLlm_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Reload from Disk" Click="ReloadSettings_Click" />
                        <Button Content="Clear History" Click="ClearHistory_Click" />
                    </StackPanel>

                    <TextBlock
                        x:Name="SaveFeedbackText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
