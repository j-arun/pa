<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentAssistantWorkbench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fluent Personal Assistant Workbench">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent Top Menu Bar -->
        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zone 1: App Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Assistant Workbench"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Zone 2: Private / Public Toggle in Top Menu Bar -->
            <Border
                Grid.Column="1"
                Padding="4"
                CornerRadius="8"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="PrivateScopeButton"
                        Content="Private (Ollama)"
                        Click="PrivateScopeButton_Click"
                        Padding="12,5"
                        CornerRadius="6" />
                    <Button
                        x:Name="PublicScopeButton"
                        Content="Public Adapter"
                        Click="PublicScopeButton_Click"
                        Padding="12,5"
                        CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Zone 3: Mute & Native Speaker Controls -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="8">
                <ToggleButton
                    x:Name="MuteToggleButton"
                    Click="MuteToggleButton_Click"
                    Padding="10,6"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="14" />
                        <TextBlock x:Name="MuteLabel" Text="Mic On" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton
                    x:Name="AutoSpeakToggleButton"
                    Click="AutoSpeakToggleButton_Click"
                    Padding="10,6"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                        <TextBlock x:Name="AutoSpeakLabel" Text="Speak Off" />
                    </StackPanel>
                </ToggleButton>

                <Button
                    x:Name="StopSpeakerButton"
                    Click="StopSpeakerButton_Click"
                    ToolTipService.ToolTip="Stop Windows Speaker"
                    Padding="10,6"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Two-Page WinUI 3 NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Cloud Workbench" Tag="workbench">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
