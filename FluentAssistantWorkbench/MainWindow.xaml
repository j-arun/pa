<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentAssistantWorkbench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentAssistantWorkbench.Controls"
    Title="Personal Assistant">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="BottomStatusRow" Height="30" />
        </Grid.RowDefinitions>

        <!-- Fluent Top Menu Bar -->
        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zone 1: App Icon & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image
                    x:Name="TopBarAppIcon"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="Personal Assistant"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Zone 2: Private / Public Toggle in Top Menu Bar -->
            <Border
                Grid.Column="1"
                Padding="4"
                CornerRadius="8"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="PrivateScopeButton"
                        Content="Private"
                        Click="PrivateScopeButton_Click"
                        Padding="14,5"
                        CornerRadius="6" />
                    <Button
                        x:Name="PublicScopeButton"
                        Content="Public"
                        Click="PublicScopeButton_Click"
                        Padding="14,5"
                        CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Zone 3: Icon-Only Mic, Speaker & Settings Toolbar Controls -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="6">
                <ToggleButton
                    x:Name="MuteToggleButton"
                    Click="MuteToggleButton_Click"
                    ToolTipService.ToolTip="Toggle Microphone"
                    AutomationProperties.Name="Toggle Microphone"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="15" />
                </ToggleButton>

                <ToggleButton
                    x:Name="AutoSpeakToggleButton"
                    Click="AutoSpeakToggleButton_Click"
                    ToolTipService.ToolTip="Toggle Windows Speaker"
                    AutomationProperties.Name="Toggle Windows Speaker"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon x:Name="AutoSpeakIcon" Glyph="&#xE767;" FontSize="15" />
                </ToggleButton>

                <Button
                    x:Name="StopSpeakerButton"
                    Click="StopSpeakerButton_Click"
                    ToolTipService.ToolTip="Stop Windows Speaker"
                    AutomationProperties.Name="Stop Windows Speaker"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>

                <Button
                    x:Name="SettingsToolbarButton"
                    Click="SettingsToolbarButton_Click"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>

                <ToggleButton
                    x:Name="ContextMonitorToggleButton"
                    IsChecked="True"
                    Click="ContextMonitorToggleButton_Click"
                    ToolTipService.ToolTip="Toggle Right LLM Context Monitor"
                    AutomationProperties.Name="Toggle Right LLM Context Monitor"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Main Workspace: Left Nav + Chat + Adjustable Splitters + Read-Only Right Context Monitor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightRailColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <!-- WinUI 3 Left NavigationView -->
            <NavigationView
                x:Name="NavView"
                Grid.Column="0"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                OpenPaneLength="200"
                PaneDisplayMode="Left"
                PaneOpened="NavView_PaneChanged"
                PaneClosed="NavView_PaneChanged"
                DisplayModeChanged="NavView_DisplayModeChanged"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Personal Assistant" Tag="workbench">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.PaneFooter>
                    <Button
                        Click="ProfileSync_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,8"
                        Margin="6,0,6,8"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Synced from your Windows account profile">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PersonPicture
                                x:Name="UserAvatarPicture"
                                Width="34"
                                Height="34" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="UserDisplayNameText"
                                    Text="Windows User"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="126" />
                                <TextBlock
                                    Text="Windows Account"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </NavigationView.PaneFooter>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- Left Rail Drag Resizer -->
            <controls:PaneSplitter
                x:Name="LeftPaneSplitter"
                Grid.Column="0"
                Width="6"
                HorizontalAlignment="Left"
                Margin="197,0,0,0"
                ResizeDirection="Vertical"
                DragStarted="LeftPaneSplitter_DragStarted"
                DragDelta="LeftPaneSplitter_DragDelta"
                ToolTipService.ToolTip="Drag to resize left rail" />

            <!-- Right Rail Drag Resizer -->
            <controls:PaneSplitter
                x:Name="RightPaneSplitter"
                Grid.Column="1"
                Width="6"
                ResizeDirection="Vertical"
                DragStarted="RightPaneSplitter_DragStarted"
                DragDelta="RightPaneSplitter_DragDelta"
                ToolTipService.ToolTip="Drag to resize right LLM context monitor" />

            <!-- Read-Only Right Side Context Monitor Rail -->
            <Border
                x:Name="RightContextRail"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Rail Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="1">
                            <TextBlock
                                Text="LLM Context Monitor"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Read-only live telemetry &amp; logs"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border
                            x:Name="MonitorPhaseBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            CornerRadius="6"
                            Padding="8,3"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="MonitorPhaseText"
                                Text="Idle"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Live Progress -->
                    <Border
                        Grid.Row="1"
                        Padding="10"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="MonitorProgressText"
                                Text="Waiting for next prompt"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar
                                x:Name="MonitorProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                IsIndeterminate="False" />
                        </StackPanel>
                    </Border>

                    <!-- Prompt / Token / Speed / Duration Metrics -->
                    <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Prompt Size" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricPromptSizeText" Text="—" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Tokens Loaded" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricTokensLoadedText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Input Tokens" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricInputTokensText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Output Tokens" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricOutputTokensText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Speed" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricSpeedText" Text="— tok/s" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Time Taken" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricDurationText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Read-Only Errors Box -->
                    <Border
                        x:Name="MonitorErrorBox"
                        Grid.Row="3"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Status / Errors" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="MonitorErrorText"
                                Text="Healthy · No active errors"
                                FontSize="11"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Limited Moving Context Logs (Max 12 LLM Context Events) -->
                    <Border
                        Grid.Row="4"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock
                                    Text="Context Events (Moving · 12 max)"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="ContextLogsEmptyText"
                                        Text="No LLM context events yet."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsControl x:Name="ContextLogsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{Binding IndicatorBrush}"
                                                        VerticalAlignment="Top"
                                                        Margin="0,5,0,0" />
                                                    <TextBlock
                                                        Text="{Binding FormattedLine}"
                                                        FontFamily="Cascadia Code, Consolas"
                                                        FontSize="11"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Panel Drag Resizer -->
        <controls:PaneSplitter
            x:Name="BottomPaneSplitter"
            Grid.Row="2"
            Height="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ResizeDirection="Horizontal"
            DragStarted="BottomPaneSplitter_DragStarted"
            DragDelta="BottomPaneSplitter_DragDelta"
            ToolTipService.ToolTip="Drag up or down to resize bottom panel" />

        <!-- Bottom Panel Status Bar (Engine + Live LLM Stats) -->
        <Grid
            Grid.Row="3"
            Padding="14,4"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#10B981" />
                    <TextBlock
                        x:Name="StatusBarEngineText"
                        Text="Connected: Private · Windows Ollama"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="StatusBarLlmStateText"
                        Text="Idle"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="StatusBarTokensText"
                        Text="Tokens: —"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="StatusBarSpeedText"
                        Text="— tok/s"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="StatusBarTimeText"
                        Text="—"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Expanded Bottom Telemetry Row (visible when bottom panel is resized taller) -->
            <TextBlock
                x:Name="BottomExpandedTelemetryText"
                Grid.Row="1"
                Margin="0,4,0,0"
                Visibility="Collapsed"
                FontFamily="Cascadia Code, Consolas"
                FontSize="11"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Prompt Size: — · Input: — · Output: — · Status: Healthy" />
        </Grid>

        <!-- Compact Settings Modal Dialog -->
        <Grid
            x:Name="SettingsModalOverlay"
            Grid.RowSpan="4"
            Visibility="Collapsed"
            Background="#7A000000"
            Padding="24">
            <Border
                MaxWidth="680"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Compact Modal Header -->
                    <Grid
                        Grid.Row="0"
                        Padding="20,14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            Text="Personal Assistant Settings"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            VerticalAlignment="Center" />
                        <Button
                            Click="CloseSettings_Click"
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="Close"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="8">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Scrollable Settings Content -->
                    <Frame x:Name="SettingsModalFrame" Grid.Row="1" />

                    <!-- Sticky Apply / Save & Close Footer -->
                    <Grid
                        Grid.Row="2"
                        Padding="20,12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            x:Name="SettingsModalFeedbackText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                            <Button Content="Close" Click="CloseSettings_Click" />
                            <Button Content="Apply" Click="ApplySettings_Click" />
                            <Button
                                Content="Save &amp; Close"
                                Click="SaveAndCloseSettings_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
