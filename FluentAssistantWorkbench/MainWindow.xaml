<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentAssistantWorkbench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Personal Assistant">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Fluent Top Menu Bar -->
        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zone 1: App Icon & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image
                    Source="ms-appx:///Assets/PersonalAssistant.png"
                    Width="22"
                    Height="22"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="Personal Assistant"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Zone 2: Private / Public Toggle in Top Menu Bar -->
            <Border
                Grid.Column="1"
                Padding="4"
                CornerRadius="8"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="PrivateScopeButton"
                        Content="Private"
                        Click="PrivateScopeButton_Click"
                        Padding="14,5"
                        CornerRadius="6" />
                    <Button
                        x:Name="PublicScopeButton"
                        Content="Public"
                        Click="PublicScopeButton_Click"
                        Padding="14,5"
                        CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Zone 3: Icon-Only Mic, Speaker & Settings Toolbar Controls -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="6">
                <ToggleButton
                    x:Name="MuteToggleButton"
                    Click="MuteToggleButton_Click"
                    ToolTipService.ToolTip="Toggle Microphone"
                    AutomationProperties.Name="Toggle Microphone"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="15" />
                </ToggleButton>

                <ToggleButton
                    x:Name="AutoSpeakToggleButton"
                    Click="AutoSpeakToggleButton_Click"
                    ToolTipService.ToolTip="Toggle Windows Speaker"
                    AutomationProperties.Name="Toggle Windows Speaker"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon x:Name="AutoSpeakIcon" Glyph="&#xE767;" FontSize="15" />
                </ToggleButton>

                <Button
                    x:Name="StopSpeakerButton"
                    Click="StopSpeakerButton_Click"
                    ToolTipService.ToolTip="Stop Windows Speaker"
                    AutomationProperties.Name="Stop Windows Speaker"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>

                <Button
                    x:Name="SettingsToolbarButton"
                    Click="SettingsToolbarButton_Click"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    Width="36"
                    Height="34"
                    Padding="0"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Two-Page WinUI 3 NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Personal Assistant" Tag="workbench">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button
                    Click="ProfileUpload_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,8"
                    Margin="6,0,6,8"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Click to upload your photo">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PersonPicture
                            x:Name="UserAvatarPicture"
                            Width="34"
                            Height="34" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="UserDisplayNameText"
                                Text="Windows User"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="138" />
                            <TextBlock
                                Text="Upload photo"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Bottom Panel Status Bar -->
        <Grid
            Grid.Row="2"
            Padding="14,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#10B981" />
                <TextBlock
                    x:Name="StatusBarEngineText"
                    Text="Connected: Private · Windows Ollama"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                Text="%LOCALAPPDATA%\FluentAssistantWorkbench"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
