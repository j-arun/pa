<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentAssistantWorkbench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentAssistantWorkbench.Controls"
    Title="Personal Assistant">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style
                x:Key="ComposerIconButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="62" />
                <Setter Property="Height" Value="62" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="BottomStatusRow" Height="220" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Padding="16,0">
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <Image
                        x:Name="TopBarAppIcon"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Personal Assistant"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <ToggleButton
                x:Name="AgentSessionSidebarToggleButton"
                Style="{StaticResource IconToggleButtonStyle}"
                Grid.Column="2"
                IsChecked="True"
                Click="AgentSessionSidebarToggleButton_Click"
                ToolTipService.ToolTip="Show or hide Agent Session Sidebar"
                AutomationProperties.Name="Toggle Agent Session Sidebar"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Path
                    Width="16"
                    Height="16"
                    Data="M3,3 H21 V21 H3 Z M15,3 V21"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1.25"
                    Stretch="Uniform" />
            </ToggleButton>
        </Grid>

        <MenuBar Grid.Row="1" Height="32">
            <MenuBarItem Title="File">
                <MenuFlyoutItem
                    Text="Personal Assistant Version 2"
                    Click="OpenPersonalAssistant_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Text="Save Conversation as PDF"
                    Click="SavePdfToolbarButton_Click" />
                <MenuFlyoutItem
                    Text="New Session"
                    Click="NewSessionToolbarButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Clear Prompt" Click="ClearPromptMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Selection">
                <MenuFlyoutItem Text="Select Prompt Text" Click="SelectPromptMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem
                    Text="Toggle Navigation Pane"
                    Click="ToggleNavigationPaneMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Main Workspace: Left Nav + Chat + Adjustable Splitters + Read-Only Right Context Monitor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightRailColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <!-- WinUI 3 Left NavigationView -->
            <NavigationView
                x:Name="NavView"
                Grid.Column="0"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                OpenPaneLength="200"
                PaneDisplayMode="Left"
                PaneOpened="NavView_PaneChanged"
                PaneClosed="NavView_PaneChanged"
                DisplayModeChanged="NavView_DisplayModeChanged"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Personal Assistant" Tag="workbench">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Reference Context" Tag="context-cache">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Settings" Tag="settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.PaneFooter>
                    <Button
                        Click="ProfileSync_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,8"
                        Margin="6,0,6,8"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Synced from your Windows account profile">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PersonPicture
                                x:Name="UserAvatarPicture"
                                Width="34"
                                Height="34" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="UserDisplayNameText"
                                    Text="Windows User"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="126" />
                                <TextBlock
                                    Text="Windows Account"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </NavigationView.PaneFooter>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- Left Rail Drag Resizer -->
            <controls:PaneSplitter
                x:Name="LeftPaneSplitter"
                Grid.Column="0"
                Width="6"
                HorizontalAlignment="Left"
                Margin="197,0,0,0"
                ResizeDirection="Vertical"
                DragStarted="LeftPaneSplitter_DragStarted"
                DragDelta="LeftPaneSplitter_DragDelta"
                ToolTipService.ToolTip="Drag to resize left rail" />

            <!-- Right Rail Drag Resizer -->
            <controls:PaneSplitter
                x:Name="RightPaneSplitter"
                Grid.Column="1"
                Width="6"
                ResizeDirection="Vertical"
                DragStarted="RightPaneSplitter_DragStarted"
                DragDelta="RightPaneSplitter_DragDelta"
                ToolTipService.ToolTip="Drag to resize Agent Session Sidebar" />

            <!-- Agent Session Sidebar -->
            <Border
                x:Name="RightContextRail"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Rail Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="1">
                            <TextBlock
                                Text="Agent Session Sidebar"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Session status, context &amp; activity"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border
                            x:Name="MonitorPhaseBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            CornerRadius="6"
                            Padding="8,3"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="MonitorPhaseText"
                                Text="Idle"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Live Progress -->
                    <Border
                        Grid.Row="1"
                        Padding="10"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="MonitorProgressText"
                                Text="Waiting for next prompt"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar
                                x:Name="MonitorProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                IsIndeterminate="False" />
                        </StackPanel>
                    </Border>

                    <!-- Prompt / Token / Speed / Duration Metrics -->
                    <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Prompt Size" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricPromptSizeText" Text="—" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Tokens Loaded" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricTokensLoadedText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Input Tokens" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricInputTokensText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Output Tokens" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricOutputTokensText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Speed" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricSpeedText" Text="— tok/s" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Time Taken" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricDurationText" Text="—" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Saved Reference (est.)" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricReferenceCacheText" Text="0 tokens" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="1" Padding="9,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Window · Remaining" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MetricContextWindowText" Text="32,768 tokens" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MetricRemainingContextText" Text="Remaining: —" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Read-Only Errors Box -->
                    <Border
                        x:Name="MonitorErrorBox"
                        Grid.Row="3"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Status / Errors" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="MonitorErrorText"
                                Text="Healthy · No active errors"
                                FontSize="11"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Limited Moving Context Logs (Max 12 LLM Context Events) -->
                    <Border
                        Grid.Row="4"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock
                                    Text="Context Events (Moving · 12 max)"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="ContextLogsEmptyText"
                                        Text="No LLM context events yet."
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsControl x:Name="ContextLogsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{Binding IndicatorBrush}"
                                                        VerticalAlignment="Top"
                                                        Margin="0,5,0,0" />
                                                    <TextBlock
                                                        Text="{Binding FormattedLine}"
                                                        FontFamily="Cascadia Code, Consolas"
                                                        FontSize="11"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Panel Drag Resizer -->
        <controls:PaneSplitter
            x:Name="BottomPaneSplitter"
            Grid.Row="3"
            Height="10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1"
            ResizeDirection="Horizontal"
            DragStarted="BottomPaneSplitter_DragStarted"
            DragDelta="BottomPaneSplitter_DragDelta"
            ToolTipService.ToolTip="Drag up or down to resize bottom panel" />

        <!-- Bottom panel shared by the navigation, conversation, and context monitor -->
        <Grid
            Grid.Row="4"
            Padding="14,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="22">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#10B981" />
                    <TextBlock
                        x:Name="StatusBarEngineText"
                        Text="Connected: Private · Windows Ollama"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="StatusBarCacheText"
                    Text="Reference: 0 est. · Used: — / 32K · Remaining: —"
                    FontSize="11"
                    FontFamily="Cascadia Code, Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid
                x:Name="PromptComposer"
                Grid.Row="1"
                Margin="0,6,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        x:Name="PromptContextStatusText"
                        Text="Reference: 0 est. · Context used: ~0 / 32K · Remaining: ~32,768"
                        FontSize="11"
                        FontFamily="Cascadia Code, Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        MinHeight="90"
                        MaxHeight="220"
                        CornerRadius="16"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0"
                                Spacing="8"
                                Opacity="0.18"
                                IsHitTestVisible="False">
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="64"
                                    Foreground="#2563EB"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="PromptModeVoiceIcon"
                                    Glyph="&#xE8BD;"
                                    FontSize="42"
                                    Foreground="#F59E0B"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox
                                x:Name="PromptTextBox"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="90"
                                MaxHeight="220"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                PreviewKeyDown="PromptTextBox_PreviewKeyDown"
                                TextChanged="PromptTextBox_TextChanged"
                                PlaceholderText="Type your prompt... (Enter to send, Shift+Enter for new line)"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="14,10"
                                VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="SendButton"
                        Click="SendButton_Click"
                        Style="{StaticResource ComposerIconButtonStyle}"
                        ToolTipService.ToolTip="Send prompt"
                        AutomationProperties.Name="Send prompt">
                        <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="18" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
